# IB Flex Web Service 配置（占位模板，复制为项目根目录 .env 后填真实值）
# 注意：真实 .env 放在 D:\Study\arbTest\.env（仓库根是 src\，项目根天然在 git 外），勿放进 src\ 内。
# Token 等同只读凭据，切勿硬编码进代码、切勿贴入聊天/提交 git。

# Flex Web Service Token（Client Portal 生成，默认 6 小时有效，可延长）
IB_FLEX_TOKEN=

# Activity Flex Query 的 Query ID（Reports -> Flex Queries 建 Activity Flex Query 得到）
IB_FLEX_QUERY_ID=

# 可选：多账户时只拉某个账户（填账户号如 U13561178）；留空=拉全部账户
IB_FLEX_ACCOUNT=
